# Hébergement mutualisé OVH (Apache). Ce fichier part dans la racine du site.

# ── Forcer HTTPS ───────────────────────────────────────────────────────────
# Le certificat est actif sur maxyull.fr et www.maxyull.fr. Sans cette règle,
# les deux versions répondaient en 200 et la page restait servie en clair à qui
# tapait l'adresse sans le « s ».
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ── Fichiers qui n'ont rien à faire sur le web ─────────────────────────────
# ⚠️ `.ftp-deploy-sync-state.json` est écrit dans la racine par l'action de
# déploiement : il liste chaque fichier du site avec son empreinte. Aucun
# secret dedans, mais aucune raison de le publier — il répondait en 200.
# ⚠️ Les deux syntaxes : `Require` est de l'Apache 2.4, `Order/Deny` de la 2.2.
# Écrire la mauvaise sans garde renvoie une erreur 500 sur TOUT le site.
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Pas de listing de répertoire.
Options -Indexes

# ── En-têtes ───────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # La page ne charge RIEN de tiers : ni script, ni police, ni image externe.
  # `default-src 'self'` le dit au navigateur — c'est la partie qui protège.
  #
  # ⚠️⚠️ `'unsafe-inline'` est INDISPENSABLE ici, ne pas le retirer en croyant
  # durcir. Une première version sans lui a mis le site en ligne CASSÉ : le
  # script du plan vit dans `index.html`, et les positions des nœuds sont
  # posées en attributs `style` par ce script. Sans `'unsafe-inline'`, les deux
  # sont bloqués et il ne reste que l'en-tête — la carte disparaît, sans la
  # moindre erreur visible pour qui ne regarde pas la console.
  # Le coût est faible : la page n'a aucune entrée utilisateur, aucun
  # formulaire, et `?lang=` est comparé à deux valeurs sans jamais être inséré
  # dans le document. Il n'y a pas de vecteur d'injection à couvrir.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
</IfModule>

# ── Cache ──────────────────────────────────────────────────────────────────
# Les polices et le portrait ne changent jamais ; la page et les feuilles de
# style, si — on les garde courtes pour qu'un déploiement se voie tout de suite.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png  "access plus 30 days"
  ExpiresByType text/css   "access plus 1 hour"
  ExpiresByType text/html  "access plus 5 minutes"
</IfModule>
